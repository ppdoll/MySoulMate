# apps/web 환경변수
# 로컬에서는 .env.local 로 복사해 채운다. Vercel에서는 프로젝트 설정에 등록한다.
# NEXT_PUBLIC_* 는 브라우저 번들에 그대로 박히므로 비밀 값을 넣으면 안 된다.
# 값을 어디서 가져오는지는 docs/SETUP.md 참고.

# Supabase 대시보드 > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API Keys 의 publishable key (sb_publishable_... 로 시작)
# 공개되어도 되는 키다 — RLS로 막혀 있다.
# secret key를 여기 넣으면 절대 안 된다.
# 구형 프로젝트라 anon JWT 키만 보인다면 그걸 넣어도 동작한다(2026년 말 폐기 예정).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NestJS API 주소. 로컬은 아래, 배포는 api 쪽 Vercel 프로젝트 도메인.
NEXT_PUBLIC_API_URL=http://localhost:3001
