{
  "name": "@mysoulmate/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "pnpm --filter @mysoulmate/shared build && nest build",
    "start": "node dist/main.js",
    "check:gemini": "node scripts/check-gemini.mjs",
    "vapid:keys": "node scripts/vapid-keys.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "2.16.0",
    "@mysoulmate/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@supabase/supabase-js": "2.112.1",
    "dotenv": "17.4.2",
    "jose": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "web-push": "3.6.7",
    "ws": "8.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
