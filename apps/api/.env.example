# apps/api 환경변수
# 로컬에서는 이 파일을 .env 로 복사해 채우고, Vercel에서는 프로젝트 설정에 등록한다.
# 값을 어디서 가져오는지는 docs/SETUP.md 참고.

NODE_ENV=development
PORT=3001

# 허용할 프론트 오리진. 쉼표로 여러 개 지정할 수 있다.
# Vercel 프리뷰 배포까지 허용하려면 그 도메인도 함께 넣는다.
WEB_ORIGIN=http://localhost:3000

# Supabase 대시보드 > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings > API Keys 의 secret key (sb_secret_... 로 시작)
# RLS를 전부 우회하는 키다. 절대 프론트나 저장소에 올리면 안 된다.
# 구형 프로젝트라 service_role JWT 키만 보인다면 그걸 넣어도 동작한다(2026년 말 폐기 예정).
SUPABASE_SECRET_KEY=

# 비대칭(ES256) JWT 서명 키를 쓰는 프로젝트라면 비워둔다 — JWKS로 검증한다.
# JWT signing keys 도입 전에 만들어진 프로젝트만 레거시 HS256 시크릿을 채운다.
SUPABASE_JWT_SECRET=

# --- Gemini ---------------------------------------------------------------
# 간단하게 쓰려면 이것 하나만 채우면 된다.
GEMINI_API_KEY=

# 비용을 아끼려면 용도별로 키를 나눈다.
#
#   텍스트(페르소나·대화)는 무료 티어가 있다  -> 결제를 연결하지 않은 프로젝트의 키
#   이미지(아바타)는 무료 티어가 없다          -> 결제가 연결된 프로젝트의 키
#
# 나누면 대화 비용이 0이 되고, 선불 잔액이 바닥나도 대화는 계속 동작한다
# (잔액이 0이면 그 결제 계정에 연결된 키가 전부 함께 막히기 때문).
# 무료 티어는 분당 10회가 서비스 전체 상한이고 입력이 학습에 쓰인다는 점은 감안해야 한다.
#
# 비워두면 위의 GEMINI_API_KEY를 쓴다.
GEMINI_TEXT_API_KEY=
GEMINI_IMAGE_API_KEY=

# 모델 ID. 코드 배포 없이 바꿀 수 있도록 환경변수로 빼두었다.
# 비워두면 각각 gemini-3.6-flash / gemini-2.5-flash-image 를 쓴다.
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# --- 운영 -----------------------------------------------------------------
# 운영자 이메일. 쉼표로 여러 개.
# 이 계정들은 크레딧과 무료 쿼터 제한을 받지 않는다(테스트용).
# DB가 아니라 환경변수로 두어, 값이 새더라도 사용자가 스스로 운영자가 될 수 없게 한다.
ADMIN_EMAILS=

# 사고(thinking) 강도: MINIMAL / LOW / MEDIUM / HIGH. 비우면 모델 기본값.
# 사고 토큰은 출력 단가로 과금되고 실제로는 출력보다 훨씬 크다.
# 낮추면 비용이 크게 줄지만 품질 변화는 결과물로 확인해야 한다.
#   pnpm --filter @mysoulmate/api check:gemini  가 차이를 숫자로 보여준다.
GEMINI_THINKING_LEVEL=
