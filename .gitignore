node_modules/
dist/
build/
.next/
out/
next-env.d.ts

# 환경변수 — .env.example 만 커밋한다
.env
.env.*
!.env.example

# 구글 Cloud Console에서 받는 OAuth 클라이언트 자격증명 파일.
# 파일 이름이 매번 달라서 정확히 지정할 수 없다. Client Secret이 평문으로 들어 있으므로
# 저장소 어디에도 두지 않는다 — 값은 Supabase 대시보드에만 넣으면 된다.
*client_secret*.json
*.credentials.json
service-account*.json
*.pem
*.p12
*.key

# 캐릭터 이미지 원본. 최적화된 WebP만 커밋하고 원본은 로컬에 둔다.
# 2048px PNG는 장당 4~12MB라, 16장이면 저장소가 127MB 불어난다.
# 한 번 커밋되면 히스토리에 영구히 남아 클론이 계속 무거워진다.
apps/web/public/presets/**/*.png
/img/

.vercel/
.turbo/
*.tsbuildinfo

coverage/
*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
