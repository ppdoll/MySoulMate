{
  "name": "mysoulmate",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @mysoulmate/shared build && pnpm -r --parallel dev",
